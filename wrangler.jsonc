{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "magocoro",
  "compatibility_date": "2026-09-08",
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "LETTERS",
      "bucket_name": "magocoro-letters"
    }
  ]
}
